# Local development database
DATABASE_URL="file:./backend/data/nexra.db"

# Security Secrets (Must be changed in production)
JWT_SECRET="super_secret_key_for_access_tokens_replace_me"
JWT_REFRESH_SECRET="super_secret_key_for_refresh_tokens_replace_me"
COOKIE_SECRET="super_secret_key_for_cookies_replace_me"
SESSION_SECRET="super_secret_key_for_sessions_replace_me"

# Application Settings
PORT=1050
NODE_ENV=production
PUBLIC_URL=http://localhost:1050

# Storage
UPLOAD_PATH=/app/backend/storage/presentations
